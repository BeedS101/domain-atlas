# Deny all direct web access to this folder: it holds code and the optional settings file
# (atlas-directory-config.json). The database lives outside the web root. Defense in depth;
# nothing here is meant to be web-reachable.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
