test/.chrome-profile*/
node_modules/
__pycache__/
*.pyc
.DS_Store

# Generated by issuer-server/server.js on first run — a real private key
# and runtime state, not something to ship or commit.
issuer-server/issuer-private-key.jwk.json
issuer-server/atlas-*.json
demo-domain-a/.well-known/atlas-key.json
demo-domain-a/.well-known/atlas-revocations.json

# Same, for the second issuer-server instance README.md's "Serve the two
# demo domains" now runs for demo-domain-b (task #75/#87's Post Office) —
# its own private key + mail/roster state, plus demo-domain-b's own
# generated .well-known files, mirroring the domain-a entries above.
issuer-server/domain-b-state/
demo-domain-b/.well-known/atlas-key.json
demo-domain-b/.well-known/atlas-revocations.json

# Generated by issuer-php on first request, same reason — the private key
# plus every runtime state file it writes under lib/ and .well-known/
# (mail, roster/Post Office membership, subscribers, asset-update log,
# serial counters, the public key mirror, and revocations). None of these
# are source; they're rebuilt fresh by the PHP backend on first use.
issuer-php/lib/issuer-private-key.pem
issuer-php/lib/atlas-*.json
issuer-php/.well-known/atlas-key.json
issuer-php/.well-known/atlas-revocations.json

# Test run artifacts
test/atlas-wallet-export.json
test/atlas-identity-export.json
test/atlas-portable-identity-export.json

# Generated by directory-server/server.js — the crawled index, rebuilt from
# public manifests on every run. Not source, and stale the moment it's
# committed.
directory-server/directory-index.json

# Scratch — the raw downloaded asset kit (only the 140 .glb files actually
# used ended up in demo-domain-a/assets/furniture/, which IS committed).
/assets/
