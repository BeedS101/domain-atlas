# Deny all direct web access to this folder — it holds the issuer's private
# key (issuer-private-key.pem, generated on first request). Nothing in this
# app links to it or needs it to be web-reachable; this is defense in depth
# in case of a server misconfiguration.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
