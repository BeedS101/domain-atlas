# Deny all direct web access to this folder — it holds
# atlas-presence-store.json (everyone's current room/roster state, written
# fresh on every request). Nothing in this app links to it or needs it to
# be web-reachable; this is defense in depth in case of a server
# misconfiguration, same reasoning as issuer-php's lib/.htaccess.
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
</IfModule>
