    },
    "assetStudio": {
     "enabled": true,
     "url": "https://example.com/atlas/studio/"
    },
    "trading": {
     "enabled": true,
     "url": "https://example.com/market/"
    },
    "directory": {
     "enabled": true,
     "url": "https://example.com/atlas/directory/index.html"
    },
    "voiceCalling": true,
    "inWorldChat": true,
    "worlds": []
   },
   "expect": [
    {
     "service": "postOffice",
     "url": null
