{
  "spec": "domain-atlas/1.0",
  "domain": "localhost:8002",
  "owner": {
    "name": "Neighbor Workshop Demo",
    "contact": "demo@localhost"
  },
  "defaultWorld": "workshop",
  "postOffice": true,
  "chat": true,
  "calendar": true,
  "walletBridge": { "read": true, "sign": ["demo-login"], "offer": ["atlas.wearable.ring"] },
  "worlds": [
    {
      "id": "workshop",
      "name": "Neighbor Workshop",
      "entry": {
        "scene": "/spatial/workshop/scene.json",
        "renderer": ["procedural-v1"]
      },
      "policy": {
        "guestAccess": "open",
        "discoverable": true,
        "identityRequired": false,
        "itemDropsAllowed": true,
        "acceptedItemClasses": ["atlas.wearable", "atlas.badge"],
        "trustedIssuers": "any"
      },
      "profile": {
        "genre": "workshop",
        "scale": "building",
        "capabilities": { "building": "residents", "vehicles": false, "combat": "none", "landOwnership": false }
      },
      "portals": [
        {
          "kind": "domain",
          "to": "localhost:8001",
          "label": "Walk back to Example Plaza",
          "manifest": "http://localhost:8001/.well-known/spatial.json"
        },
        { "kind": "world", "to": "gallery", "label": "Enter the Atlas Showcase Gallery" }
      ]
    },
    {
      "id": "gallery",
      "name": "Atlas Showcase Gallery",
      "entry": {
        "scene": "/spatial/gallery/scene.json",
        "renderer": ["gltf-mini-v1"]
      },
      "policy": {
        "guestAccess": "open",
        "discoverable": true,
        "identityRequired": false,
        "itemDropsAllowed": true,
        "acceptedItemClasses": ["atlas.wearable", "atlas.badge"],
        "trustedIssuers": "any"
      },
      "profile": {
        "genre": "gallery",
        "scale": "building",
        "capabilities": { "building": "residents", "vehicles": false, "combat": "none", "landOwnership": false }
      },
      "portals": [
        { "kind": "world", "to": "workshop", "label": "Back to the Neighbor Workshop" }
      ]
    }
  ],
  "updated": "2026-08-22T00:00:00Z"
}
